[
  {
    "bookSourceUrl": "http://10.0.2.2:18765/sniff",
    "bookSourceName": "Local resource sniff fixture",
    "bookSourceType": 1,
    "searchUrl": "/sniff-search?q={{key}}",
    "ruleSearch": {
      "bookList": "li.book",
      "name": "a@text",
      "bookUrl": "a@href"
    },
