      "tocUrl": "a.toc@href"
    },
    "ruleToc": {
      "chapterList": "li.chapter",
      "chapterName": "a@text",
      "chapterUrl": "a@href"
    },
    "ruleContent": {
      "content": "@js:result",
      "sourceRegex": ".*sniff-media\\.mp3"
    }
  }
]
